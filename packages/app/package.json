{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.1.19",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
