    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "bun-types": "latest",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "turbo": "latest",
    "typescript": "^5.3.3"
  }
} 